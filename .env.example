# ============================================================
# TP_ControlVehicular - variables de entorno (plantilla)
# Copiar este archivo a ".env" (raiz del proyecto o junto al exe)
# y ajustar los valores. ".env" esta en .gitignore: NO commitear.
# ============================================================

# --- SQL Server (sobrescribe ConnectionStrings:DefaultConnection de appsettings.json) ---
TPCV_ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=ControlVehicular;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- Google Drive (opcional; si no se definen, se usa credenciales.json) ---
# TPCV_Google__ClientId=
# TPCV_Google__ClientSecret=