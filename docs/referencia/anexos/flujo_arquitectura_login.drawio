        <!-- 16. ViewModel -> DataGrid -->
        <mxCell id="edge16" value="16. DataBinding refresca DataGrid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2980B9;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node_vm_target" target="node_view_render">
