<Window x:Class="TP_ControlVehicular.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TP_ControlVehicular"
        mc:Ignorable="d"
        Title="Taller Pro" Height="504" Width="800" ShowInTaskbar="False"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid x:Name="mainWindows">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="colMenu" Width="240"/>
            <!-- Columna 0: Menú Lateral Completo -->
            <ColumnDefinition Width="*"/>
            <!-- Columna 1: Área de Trabajo -->
        </Grid.ColumnDefinitions>

        <!-- ==========================================
             MENÚ LATERAL UNIFICADO (Ocupa todo el alto)
             ========================================== -->
        <Border x:Name="pnlSidebar" Grid.Column="0" Background="#2C3E50" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">

                    <!-- LOGO O TÍTULO DEL SOFTWARE -->
                    <TextBlock Text="🛠️ TALLER PRO" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,15"/>

                    <!-- TARJETA USUARIO LOGUEADO -->
                    <Border x:Name="pnlUserInfo" Background="#34495E" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock x:Name="lblUsuarioNombre" Text="👤 Usuario" Foreground="White" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="lblUsuarioRol" Text="🛡️ Rol: -" Foreground="#BDC3C7" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- BOTÓN DASHBOARD (ARRIBA DE OPERACIONES) -->
                    <Button x:Name="btnDashboard" Content="📊 Dashboard" Click="MenuItem_Click_Dashboard" 
                            Margin="0,0,0,15" Padding="10,8" HorizontalContentAlignment="Left" Background="#2980B9" Foreground="White" BorderThickness="0" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- SECCIÓN 1: OPERACIONES -->
                    <TextBlock x:Name="secOperaciones" Text="OPERACIONES" Foreground="#95A5A6" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Button x:Name="btnOrdenesTrabajo" Content="📋 Órdenes de Trabajo" Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- ESPACIADOR -->
                    <Separator Background="#34495E" Margin="0,15"/>

                    <!-- SECCIÓN 2: CATÁLOGOS / ABMs -->
                    <TextBlock x:Name="secAdministracion" Text="ADMINISTRACIÓN" Foreground="#95A5A6" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>

                    <!-- Botón Servicios -->
                    <Button x:Name="btnServicio" Content="📦 Servicios" Click="MenuItem_Click_Servicio" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- Botón Cliente -->
                    <Button x:Name="btnCliente" Content="👤 Clientes" Click="MenuItem_Click_Cliente" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- Botón Vehículo -->
                    <Button x:Name="btnVehiculo" Content="🚗 Vehículos" Click="MenuItem_Click_Vehiculo" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- Botón Modelo -->
                    <Button x:Name="btnModelo" Content="🏷️ Modelos de Autos" Click="MenuItem_Click_Modelo" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- Botón Marca -->
                    <Button x:Name="btnMarca" Content="🏢 Marcas" Click="MenuItem_Click_Marca" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- Botón Taller -->
                    <Button x:Name="btnTaller" Content="🔧 Talleres" Click="MenuItem_Click_Taller" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- Botón Usuario -->
                    <Button x:Name="btnUsuario" Content="🔑 Usuarios" Click="MenuItem_Click_Usuario" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- Botón Rol -->
                    <Button x:Name="btnRol" Content="🛡️ Roles" Click="MenuItem_Click_Rol" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    
                    <!-- ESPACIADOR -->
                    <Separator x:Name="sepReportes" Background="#34495E" Margin="0,15"/>

                    <!-- SECCIÓN 3: REPORTES -->
                    <TextBlock x:Name="secReportes" Text="REPORTES" Foreground="#95A5A6" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Button x:Name="btnReporteOrdenes" Content="📋 Reporte Órdenes" Click="MenuItem_Click_ReporteOrdenes" 
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0"/>

                    <!-- ESPACIADOR -->
                    <Separator Background="#34495E" Margin="0,15"/>
                    
                    <!-- Botón Salir -->
                    <Button x:Name="btnSalir" Content="❌ Cerrar Sesión" Click="MenuItem_Click_Salir"
                            Margin="0,3" Padding="10,8" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#E74C3C" FontWeight="SemiBold" BorderThickness="0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==========================================
             ÁREA DE TRABAJO DINÁMICA (grdContenido)
             ========================================== -->
        <Grid x:Name="grdContenido" Grid.Column="1" Background="#F5F7FA" Margin="15">
            <!-- Los UserControls se inyectan dinámicamente -->
        </Grid>

        <!-- ==========================================
             BOTÓN DE CIERRE DE APLICACIÓN (Top-Right)
             ========================================== -->
        <Button x:Name="btnCerrarApp" 
                Content="✖" 
                Click="BtnCerrarApp_Click"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Margin="0,12,15,0"
                Width="36" 
                Height="36"
                Background="#E74C3C" 
                Foreground="White" 
                FontWeight="Bold" 
                FontSize="16"
                Cursor="Hand"
                ToolTip="Cerrar Aplicación"
                Panel.ZIndex="999">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>
