<UserControl x:Class="TP_ControlVehicular.Presentacion.Modelo.CtlModelo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TP_ControlVehicular.Presentacion.Modelo"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Control de Modelos" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Administración de modelos de vehículos" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- Barra superior -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar modelo..." />

            <Button Grid.Column="1" Content="Nuevo Modelo" Width="120" Height="25"
                    HorizontalAlignment="Right" Click="BtnNuevo_Click"/>
        </Grid>

        <!-- Tabla de modelos -->
        <DataGrid Grid.Row="2"
                  x:Name="dgModelos"
                  ItemsSource="{Binding ListadoModelosFiltered}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdModelo}" Width="70"/>
                <DataGridTextColumn Header="Nombre Modelo" Binding="{Binding NombreModelo}" Width="150"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding MarcaNombre}" Width="150"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Barra inferior -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Editar Seleccionado" Width="140" Height="28" Margin="0,0,10,0" Click="BtnEditar_Click"/>
            <Button Content="Eliminar Seleccionado" Width="140" Height="28" Click="BtnBorrar_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
