<UserControl x:Class="TP_ControlVehicular.Presentacion.Vehiculo.CtlVehiculo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TP_ControlVehicular.Presentacion.Vehiculo"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Control de Vehículos" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Administración de vehículos registrados" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- Barra superior -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar vehículo..." />

            <Button Grid.Column="1" Content="Nuevo Vehículo" Width="120" Height="25"
                    HorizontalAlignment="Right" Click="BtnNuevo_Click"/>
        </Grid>

        <!-- Tabla de vehículos -->
        <DataGrid Grid.Row="2"
                  x:Name="dgVehiculos"
                  ItemsSource="{Binding ListadoVehiculosFiltered}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdVehiculo}" Width="70"/>
                <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="120"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="150"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding ModeloNombre}" Width="150"/>
                <DataGridTextColumn Header="Año" Binding="{Binding Anio}" Width="80"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="100"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Barra inferior -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Editar Seleccionado" Width="140" Height="28" Margin="0,0,10,0" Click="BtnEditar_Click"/>
            <Button Content="Eliminar Seleccionado" Width="140" Height="28" Click="BtnBorrar_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
