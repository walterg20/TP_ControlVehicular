<UserControl x:Class="TP_ControlVehicular.Presentacion.Pantalla.Reporte.CtlReporteOrdenes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de Filtros -->
            <RowDefinition Height="*"/>
            <!-- Tabla de Reporte -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📋 Reporte de Órdenes de Trabajo" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
            </StackPanel>
            <Button Content="🔄 Actualizar" 
                    Command="{Binding CargarReporteCommand}" 
                    HorizontalAlignment="Right" 
                    Padding="14,8" 
                    Background="#2980B9" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- BARRA DE FILTROS (rounded-xl & shadow-sm) -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda General -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                             Width="320" Padding="8,6" FontSize="13" BorderBrush="#BDC3C7" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Filtro por Estado -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Estado:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,8,0"/>
                    <ComboBox SelectedValue="{Binding EstadoFiltro, Mode=TwoWay}" SelectedValuePath="Content" Width="130" Padding="8,6">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Pendiente"/>
                        <ComboBoxItem Content="En Proceso"/>
                        <ComboBoxItem Content="Completada"/>
                        <ComboBoxItem Content="Entregada"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLA DE REPORTE DETALLADA -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>

            <DataGrid x:Name="dgReporte" 
                      ItemsSource="{Binding ListadoOrdenesFiltered}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" 
                      HeadersVisibility="Column" 
                      Background="Transparent" 
                      BorderThickness="0"
                      RowHeaderWidth="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Orden" Binding="{Binding IdOrden}" Width="80"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaIngreso, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="120"/>
                    <DataGridTextColumn Header="Patente" Binding="{Binding Patente}" Width="90"/>
                    <DataGridTextColumn Header="Vehículo (Marca-Modelo)" Binding="{Binding MarcaModelo}" Width="160"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="140"/>
                    <DataGridTextColumn Header="Km Ingreso" Binding="{Binding KmIngresado, StringFormat={}{0:N0} km}" Width="100"/>
                    <DataGridTextColumn Header="Servicios Aplicados" Binding="{Binding ServiciosAplicados}" Width="*"/>
                    <DataGridTextColumn Header="Mecánico" Binding="{Binding MecanicoNombre}" Width="140"/>
                    <DataGridTextColumn Header="Recepcionista" Binding="{Binding RecepcionistaNombre}" Width="140"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
