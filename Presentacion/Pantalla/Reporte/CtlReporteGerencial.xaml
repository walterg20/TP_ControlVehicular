<UserControl x:Class="TP_ControlVehicular.Presentacion.Pantalla.Reporte.CtlReporteGerencial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📈 Reporte Gerencial (Administrador)" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
            </StackPanel>
        </Grid>

        <!-- FILTROS GLOBALES -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FILA 0: FILTROS (GRID CON ETIQUETAS SUPERIORES) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- DESDE -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Desde" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding FechaDesde, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- HASTA -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hasta" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding FechaHasta, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- FILA 1: SEPARADOR HORIZONTAL SUTIL -->
                <Border Grid.Row="1" Height="1" Background="#F0F3F4" Margin="0,14,0,14"/>

                <!-- FILA 2: ACCIONES INFERIORES -->
                <Grid Grid.Row="2">
                    <Button HorizontalAlignment="Left" Content="🔍 Consultar" Command="{Binding CargarReporteCommand}"
                            Padding="16,7" Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Cargar datos del reporte gerencial">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- FILA 3: MENSAJE DE VALIDACION -->
                <TextBlock Grid.Row="3" Text="{Binding MensajeValidacion}" Foreground="#E74C3C" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- PESTAÑAS (TAB CONTROL) -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>

            <TabControl Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Ingresos -->
                <TabItem Header="Ingresos Totales" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="📄 Imprimir PDF (Ingresos)" Command="{Binding ImprimirPdfIngresosCommand}" 
                                HorizontalAlignment="Left" Margin="0,0,0,15" Padding="14,8" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Ingresos}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2C3E50"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10,8"/></Style>
                                <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,6"/></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                                <DataGridTextColumn Header="Cantidad Facturas" Binding="{Binding CantidadFacturas}" Width="150"/>
                                <DataGridTextColumn Header="Ingresos Totales" Binding="{Binding IngresosTotales, StringFormat={}{0:C}}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Top Clientes -->
                <TabItem Header="Top Clientes" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="📄 Imprimir PDF (Top Clientes)" Command="{Binding ImprimirPdfTopClientesCommand}" 
                                HorizontalAlignment="Left" Margin="0,0,0,15" Padding="14,8" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TopClientes}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2C3E50"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10,8"/></Style>
                                <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,6"/></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCompleto}" Width="250"/>
                                <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="150"/>
                                <DataGridTextColumn Header="Cant. Servicios" Binding="{Binding CantidadServicios}" Width="150"/>
                                <DataGridTextColumn Header="Total Gastado" Binding="{Binding TotalGastado, StringFormat={}{0:C}}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Modelos más reparados -->
                <TabItem Header="Modelos Más Reparados" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="📄 Imprimir PDF (Modelos)" Command="{Binding ImprimirPdfModelosCommand}" 
                                HorizontalAlignment="Left" Margin="0,0,0,15" Padding="14,8" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ModelosReparados}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2C3E50"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10,8"/></Style>
                                <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,6"/></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Veh&#237;culo (Marca - Modelo)" Binding="{Binding MarcaModelo}" Width="300"/>
                                <DataGridTextColumn Header="Cant. Reparaciones" Binding="{Binding CantidadReparaciones}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 4: Servicios por rango de fechas -->
                <TabItem Header="Servicios por Rango" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Imprimir PDF (Servicios por Rango)" Command="{Binding ImprimirPdfServiciosCommand}" 
                                HorizontalAlignment="Left" Margin="0,0,0,15" Padding="14,8" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ServiciosPorRango}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2C3E50"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10,8"/></Style>
                                <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,6"/></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="300"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
