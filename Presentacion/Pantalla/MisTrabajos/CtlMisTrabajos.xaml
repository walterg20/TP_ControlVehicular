<UserControl x:Class="TP_ControlVehicular.Presentacion.Pantalla.MisTrabajos.CtlMisTrabajos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TP_ControlVehicular.Presentacion.Pantalla.MisTrabajos"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024" Background="#F4F6F7">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🔧 Mis Trabajos" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Panel de órdenes y tareas asignadas" FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- BARRA DE BUSQUEDA Y FILTROS -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                             Width="220" Padding="8,6" FontSize="13" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,15,0"
                             ToolTip="Nº de orden, patente o cliente">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mostrar:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,10,0"/>
                    <ComboBox Width="150" Height="30" SelectedValue="{Binding FiltroEstado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Pendientes"/>
                        <ComboBoxItem Content="Finalizados"/>
                        <ComboBoxItem Content="Todos"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAESTRO: ORDENES -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🧾 Órdenes asignadas (doble clic para abrir)" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10" Margin="0,30,0,0">
                        <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Foreground="#BDC3C7"/>
                        <TextBlock Text="No hay órdenes para mostrar" FontSize="16" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgOrdenes"
                              ItemsSource="{Binding OrdenesView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectedItem="{Binding OrdenSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              MouseDoubleClick="DgOrdenes_MouseDoubleClick"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeaderWidth="0">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nº Orden" Binding="{Binding OrdenId}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Vehículo" Binding="{Binding VehiculoCompleto}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteDetalle}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Km" Binding="{Binding KmIngreso}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Progreso" Binding="{Binding Progreso}" Width="90" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- SEPARADOR -->
        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

        <!-- DETALLE: TAREAS DE LA ORDEN SELECCIONADA -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="20" Margin="0,8,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛠️ Tareas de la Orden" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="{Binding OrdenSeleccionada.OrdenId, StringFormat= #{0}}" FontSize="14" FontWeight="Bold" Foreground="#2980B9" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding OrdenSeleccionada.VehiculoCompleto}" FontSize="12" Foreground="#7F8C8D" Margin="12,1,0,0"/>
                    </StackPanel>

                    <Button Content="🔗 Ver Orden Completa" Click="BtnVerOrden_Click" HorizontalAlignment="Right"
                            Padding="12,6" Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Visibility="{Binding HayOrdenSeleccionada, Converter={StaticResource BoolToVis}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoHayOrdenSeleccionada, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                        <TextBlock Text="👈" FontSize="40" HorizontalAlignment="Center" Foreground="#BDC3C7"/>
                        <TextBlock Text="Seleccione una orden para ver sus tareas" FontSize="15" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgTareasDeOrden"
                              ItemsSource="{Binding TareasDeOrden}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeaderWidth="0">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarea" Binding="{Binding TareaNombre}" Width="220" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Observaciones" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Observaciones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Revisado / OK" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Realizado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- PIE DE ACCIONES -->
        <Border Grid.Row="5" Background="White" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="📋 Tareas del Día" Command="{Binding ImprimirHojaTrabajoCommand}" Padding="12,8" Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Visibility="{Binding PuedeVerReportesMecanico, Converter={StaticResource BoolToVis}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="🕒 Imprimir Historial Clínico" Command="{Binding ImprimirHistorialCommand}" Padding="12,8" Background="#8E44AD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Visibility="{Binding PuedeImprimirHistorial, Converter={StaticResource BoolToVis}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="💾 Guardar Cambios" Click="BtnGuardar_Click" Padding="12,8" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
