<Window x:Class="TP_ControlVehicular.Presentacion.Vehiculo.FrmVehiculo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vehículo" Height="500" Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=txtPatente}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="lblTituloFormulario" Text="Datos del Vehículo" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
        </StackPanel>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Patente:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtPatente" Height="30"
                             Text="{Binding Patente, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtPatente, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtPatente, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cliente:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                    <ComboBox x:Name="cmbCliente" Height="30"
                               ItemsSource="{Binding ClientesDisponibles}" DisplayMemberPath="NombreCompletoConDni" SelectedValuePath="IdCliente"
                               SelectedValue="{Binding IdCliente, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=cmbCliente, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=cmbCliente, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Marca:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbMarca" Grid.Column="0" Height="30" Margin="0,0,5,0"
                                  ItemsSource="{Binding MarcasDisponibles}" DisplayMemberPath="NombreMarca" SelectedValuePath="Id"
                                  SelectedValue="{Binding IdMarca, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                        <Button x:Name="btnAgregarMarca" Grid.Column="1" Content="➕" Width="30" Height="30"
                                ToolTip="Agregar nueva Marca" Background="#27AE60" Foreground="White" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand" Click="BtnAgregarMarca_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=cmbMarca, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=cmbMarca, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Modelo:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbModelo" Grid.Column="0" Height="30" Margin="0,0,5,0"
                                  ItemsSource="{Binding ModelosDisponibles}" DisplayMemberPath="NombreModelo" SelectedValuePath="Id"
                                  SelectedValue="{Binding IdModelo, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                        <Button x:Name="btnAgregarModelo" Grid.Column="1" Content="➕" Width="30" Height="30"
                                ToolTip="Agregar nuevo Modelo" Background="#27AE60" Foreground="White" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand" Click="BtnAgregarModelo_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=cmbModelo, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=cmbModelo, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Año:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtAnio" Height="30"
                             Text="{Binding Anio, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtAnio, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtAnio, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Km Actual:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtKmActual" Height="30"
                             Text="{Binding KmActual, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtKmActual, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtKmActual, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Guardar" Width="95" Height="34" IsDefault="True" Click="BtnGuardar_Click" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cancelar" Width="95" Height="34" Click="BtnCancelar_Click" 
                    Background="#C0392B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
