<Window x:Class="TP_ControlVehicular.Presentacion.Taller.FrmTaller"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TP_ControlVehicular.Presentacion.Taller"
        mc:Ignorable="d"
        Title="Taller" Height="340" Width="400"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="lblTituloFormulario" Text="Datos del Taller" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontWeight="Bold" Margin="0,0,5,2"/>
            <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="1" Height="28" Margin="0,0,0,5"
                 Text="{Binding Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dirección:" FontWeight="Bold" Margin="0,5,5,2"/>
            <TextBox x:Name="txtDireccion" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,5"
                 Text="{Binding Direccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Teléfono:" FontWeight="Bold" Margin="0,5,5,2"/>
            <TextBox x:Name="txtTelefono" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,5"
                 Text="{Binding Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3" Margin="0,5">
            <Button Content="Guardar" Width="80" Height="30" IsDefault="True" Click="BtnGuardar_Click" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Width="80" Height="30" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>