<Window x:Class="TP_ControlVehicular.Presentacion.Modelo.FrmModelo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Modelo" Height="360" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=txtNombreModelo}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="lblTituloFormulario" Text="Datos del Modelo" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre Modelo:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtNombreModelo" Height="30"
                             Text="{Binding NombreModelo, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtNombreModelo, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtNombreModelo, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Marca:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbMarca" Grid.Column="0" Height="30" Margin="0,0,5,0"
                                  ItemsSource="{Binding MarcasDisponibles}" DisplayMemberPath="NombreMarca" SelectedValuePath="Id"
                                  SelectedValue="{Binding IdMarca, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                        <Button x:Name="btnAgregarMarca" Grid.Column="1" Content="+" Width="30" Height="30"
                                ToolTip="Agregar nueva Marca" FontWeight="Bold" Click="BtnAgregarMarca_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=cmbMarca, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=cmbMarca, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Guardar" Width="90" Height="32" IsDefault="True" Click="BtnGuardar_Click" Margin="0,0,12,0"/>
            <Button Content="Cancelar" Width="90" Height="32" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
