<Window x:Class="TP_ControlVehicular.Presentacion.Pantalla.Compartido.FrmConfirmacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Confirmar Acción" 
        Height="210" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="12" BorderBrush="#BDC3C7" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.15" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Encabezado -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Mensaje -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Botones -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="12,12,0,0" Padding="15,10">
                <TextBlock x:Name="lblTitulo" 
                           Text="⚠️ Confirmar Acción" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"/>
            </Border>

            <!-- CUERPO DE MENSAJE -->
            <Grid Grid.Row="1" Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblIcono" 
                           Grid.Column="0" 
                           Text="❓" 
                           FontSize="32" 
                           VerticalAlignment="Center" 
                           Margin="0,0,15,0"/>

                <TextBlock x:Name="lblMensaje" 
                           Grid.Column="1" 
                           Text="¿Está seguro de realizar esta acción?" 
                           FontSize="14" 
                           Foreground="#2C3E50" 
                           TextWrapping="Wrap" 
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- BOTONES -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,12,12" Padding="15,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Botón Aceptar / Sí -->
                    <Button x:Name="btnAceptar" 
                            Content="✓ Sí, Aceptar" 
                            Click="BtnAceptar_Click"
                            Width="125" Height="36" 
                            Background="#27AE60" Foreground="White" 
                            FontWeight="Bold" FontSize="13" 
                            BorderThickness="0" Cursor="Hand" 
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botón Cancelar / No -->
                    <Button x:Name="btnCancelar" 
                            Content="❌ No, Cancelar" 
                            Click="BtnCancelar_Click"
                            Width="125" Height="36" 
                            Background="#C0392B" Foreground="White" 
                            FontWeight="Bold" FontSize="13" 
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
