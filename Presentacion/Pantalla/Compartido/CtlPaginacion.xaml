<UserControl x:Class="TP_ControlVehicular.Presentacion.Pantalla.Compartido.CtlPaginacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="800">

    <!-- Barra de paginación reutilizable. El estado se recibe por la propiedad Model (IPaginacion). -->
    <Border x:Name="LayoutRoot"
            Background="#F8F9F9"
            BorderBrush="#E5E7E9"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            Margin="0,10,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Selector de tamaño de página -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filas por página:" VerticalAlignment="Center" Foreground="#566573" FontSize="12" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding OpcionesTamanoPagina}"
                          SelectedItem="{Binding TamanoPagina}"
                          Width="65" Height="28" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Indicador de página -->
            <TextBlock Grid.Column="1"
                       Text="{Binding TextoPaginacion}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#2C3E50" FontSize="12"/>

            <!-- Botones de navegación -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#x23EE;" Command="{Binding IrPrimeraPaginaCommand}"
                        Width="32" Height="28" Margin="0,0,4,0" Background="#2C3E50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Primera página">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
                <Button Content="&#x25C0;" Command="{Binding PaginaAnteriorCommand}"
                        Width="32" Height="28" Margin="0,0,8,0" Background="#2C3E50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Página anterior">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
                <Button Content="&#x25B6;" Command="{Binding PaginaSiguienteCommand}"
                        Width="32" Height="28" Margin="0,0,4,0" Background="#2C3E50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Página siguiente">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
                <Button Content="&#x23ED;" Command="{Binding IrUltimaPaginaCommand}"
                        Width="32" Height="28" Background="#2C3E50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Última página">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
