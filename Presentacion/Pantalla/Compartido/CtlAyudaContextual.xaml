<UserControl x:Class="TP_ControlVehicular.Presentacion.Pantalla.Compartido.CtlAyudaContextual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="350"
             Background="#F8F9FA">

    <Grid Margin="12">
        <StackPanel>

            <!-- Encabezado -->
            <TextBlock Text="Ayuda" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       Margin="0,0,0,12"/>

            <!-- Listado de secciones expandibles -->
            <ItemsControl Name="LstAyudas" 
                          Margin="0,0,0,0"
                          ItemsSource="{Binding Secciones, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Titulo}" 
                                  IsExpanded="{Binding Expandida, Mode=TwoWay}"
                                  Margin="0,4,0,0"
                                  Background="#FFFFFF"
                                  BorderBrush="#E0E0E0"
                                  BorderThickness="1">
                            <TextBlock Text="{Binding Contenido}" 
                                      TextWrapping="Wrap"
                                      Foreground="#555555"
                                      FontSize="11"
                                      Padding="8,8,8,8"
                                      LineHeight="16"/>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sin ayuda disponible -->
            <TextBlock Name="TxtSinAyuda"
                      Text="No hay ayuda disponible para este elemento"
                      Foreground="#999999"
                      TextAlignment="Center"
                      FontSize="11"
                      Margin="0,20,0,0"
                      Visibility="Collapsed"/>
        </StackPanel>
    </Grid>

</UserControl>
