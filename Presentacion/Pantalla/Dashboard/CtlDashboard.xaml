<UserControl x:Class="TP_ControlVehicular.Presentacion.Pantalla.Dashboard.CtlDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:compartido="clr-namespace:TP_ControlVehicular.Presentacion.Pantalla.Compartido"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="BotonActualizarDashboard" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📊 Dashboard General" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="btnActualizarDashboard"
                    Content="🔄 Actualizar"
                    Command="{Binding CargarDashboardCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="14,8"
                    Style="{StaticResource BotonActualizarDashboard}"/>
        </Grid>

        <!-- TARJETAS DE RESUMEN (rounded-xl & shadow-md) -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="{Binding TarjetasResumenVisible}" Margin="0,0,0,24">

            <!-- TARJETA 1: Vehículos Activos -->
            <Border Background="#E8F8F5" CornerRadius="12" Padding="20" Margin="6,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🚗" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Vehículos Activos" FontSize="14" FontWeight="Bold" Foreground="#1E8449" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VehiculosActivosCount}" FontSize="32" FontWeight="Bold" Foreground="#27AE60"/>
                    <TextBlock Text="Con orden activa en el taller" FontSize="11" Foreground="#7D6608" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- TARJETA 2: En Proceso -->
            <Border Background="#FEF9E7" CornerRadius="12" Padding="20" Margin="6,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="📋" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="En Proceso" FontSize="14" FontWeight="Bold" Foreground="#B7950B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding EnProcesoCount}" FontSize="32" FontWeight="Bold" Foreground="#F39C12"/>
                    <TextBlock Text="Órdenes de trabajo activas" FontSize="11" Foreground="#7D6608" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- TARJETA 3: Entregadas Hoy -->
            <Border Background="#F4ECF7" CornerRadius="12" Padding="20" Margin="6,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🚚" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Entregadas Hoy" FontSize="14" FontWeight="Bold" Foreground="#6C3483" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding EntregadasHoyCount}" FontSize="32" FontWeight="Bold" Foreground="#8E44AD"/>
                    <TextBlock Text="Órdenes finalizadas" FontSize="11" Foreground="#512E5F" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- TARJETA 4: Ingresos del Mes (solo Administrador) -->
            <Border Background="#EAF2F8" CornerRadius="12" Padding="20" Margin="6,0"
                    Visibility="{Binding MostrarIngresos, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="💰" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Ingresos del Mes" FontSize="14" FontWeight="Bold" Foreground="#1A5276" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding IngresosMesTotal, StringFormat={}{0:C0}}" FontSize="32" FontWeight="Bold" Foreground="#2874A6"/>
                    <TextBlock Text="Facturado del mes a la fecha" FontSize="11" Foreground="#1A5276" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- GRAFICOS SEGUN EL ROL -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TituloSeccion}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <!-- ADMINISTRADOR: los tres graficos del Reporte Gerencial -->
                <Grid Grid.Row="1" Visibility="{Binding MostrarGraficosGerenciales, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <compartido:CtlGraficoBarras Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                        Serie="{Binding IngresosPorMes}" Titulo="Ingresos por mes" EsMonto="True"
                        Margin="0,0,16,0"/>
                    <compartido:CtlGraficoBarrasHorizontal Grid.Row="0" Grid.Column="1"
                        Serie="{Binding ModelosMasReparados}" Titulo="Modelos mas reparados"
                        Margin="10,0,0,8"/>
                    <compartido:CtlGraficoTorta Grid.Row="1" Grid.Column="1"
                        Serie="{Binding ServiciosPorRango}" Titulo="Servicios por cantidad"
                        Margin="10,8,0,0"/>
                </Grid>

                <!-- RECEPCIONISTA: ordenes por estado -->
                <compartido:CtlGraficoBarras Grid.Row="1"
                    Serie="{Binding OrdenesPorEstado}" Titulo="Ordenes por estado"
                    Visibility="{Binding MostrarGraficoOrdenes, Converter={StaticResource BoolToVis}}"/>

                <!-- MECANICO: sus tareas por estado y su avance -->
                <Grid Grid.Row="1" Visibility="{Binding MostrarGraficoMecanico, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <compartido:CtlGraficoBarras Grid.Column="0"
                        Serie="{Binding TareasPorEstado}" Titulo="Mis tareas por estado"
                        Margin="0,0,18,0"/>
                    <compartido:CtlGraficoAnilloProgreso Grid.Column="1"
                        Porcentaje="{Binding PorcentajeAvance}" Titulo="Avance de mis tareas"/>
                </Grid>
            </Grid>
        </Border>


    </Grid>
</UserControl>
