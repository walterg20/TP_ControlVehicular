<Window x:Class="TP_ControlVehicular.Presentacion.Cliente.FrmCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TP_ControlVehicular.Presentacion.Cliente"
        mc:Ignorable="d"
        Title="Cliente" Height="560" Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=txtNombre}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="lblTituloFormulario" Text="Datos del Cliente" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtNombre" Height="30"
                             Text="{Binding Nombre, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtNombre, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtNombre, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Apellido:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtApellido" Height="30"
                             Text="{Binding Apellido, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtApellido, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtApellido, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="DNI:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtDni" Height="30"
                             Text="{Binding Dni, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtDni, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtDni, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha Nac.:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,16">
                    <DatePicker x:Name="dpFechaNac" Height="30"
                                SelectedDate="{Binding FechaNacimiento, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=dpFechaNac, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=dpFechaNac, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Dirección:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtDireccion" Height="30"
                             Text="{Binding Direccion, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtDireccion, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtDireccion, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Email:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtEmail" Height="30"
                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtEmail, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtEmail, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Teléfono:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtTelefono" Height="30"
                             Text="{Binding Telefono, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtTelefono, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtTelefono, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Estado:" FontWeight="Bold" Margin="0,5,5,2"/>
                <CheckBox x:Name="chkEstado" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,16"
                          IsChecked="{Binding Activo, Mode=TwoWay}" />
            </Grid>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Guardar" Width="90" Height="32" IsDefault="True" Click="BtnGuardar_Click" Margin="0,0,12,0"/>
            <Button Content="Cancelar" Width="90" Height="32" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
