<Window x:Class="TP_ControlVehicular.Presentacion.Marca.FrmMarca"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Marca" Height="320" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=txtNombreMarca}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="lblTituloFormulario" Text="Datos de la Marca" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre Marca:" FontWeight="Bold" Margin="0,5,5,2"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox x:Name="txtNombreMarca" Height="30"
                             Text="{Binding NombreMarca, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtNombreMarca, FallbackValue=''}"
                               Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding (Validation.HasError), ElementName=txtNombreMarca, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Guardar" Width="90" Height="32" IsDefault="True" Click="BtnGuardar_Click" Margin="0,0,12,0"/>
            <Button Content="Cancelar" Width="90" Height="32" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
