<UserControl x:Class="TP_ControlVehicular.Presentacion.Pantalla.OrdenServicio.CtlOrdenServicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources><Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de Búsqueda y Acción Superior -->
            <RowDefinition Height="*"/>
            <!-- Tabla de Órdenes -->
            <RowDefinition Height="Auto"/>
            <!-- Pie de Acciones -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="📋 Control de Órdenes de Servicio" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Administración de órdenes de trabajo del sistema" FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- BARRA DE FILTROS, BUSQUEDA Y ACCIONES -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FILA 0: FILTROS (GRID DE 4 COLUMNAS FLUIDAS) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. BUSCAR -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Buscar" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="34" VerticalContentAlignment="Center" Padding="8,6" FontSize="13" 
                                 BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- 2. DESDE -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Desde" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding FechaDesde, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- 3. HASTA -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Hasta" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding FechaHasta, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- 4. ESTADO -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Estado" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding EstadoFiltro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  SelectedValuePath="Content" Height="34" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                            <ComboBoxItem Content="Abierta"/>
                            <ComboBoxItem Content="En Proceso"/>
                            <ComboBoxItem Content="Completada"/>
                            <ComboBoxItem Content="Pagada"/>
                            <ComboBoxItem Content="Cancelada"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- FILA 1: SEPARADOR HORIZONTAL SUTIL -->
                <Border Grid.Row="1" Height="1" Background="#F0F3F4" Margin="0,14,0,14"/>

                <!-- FILA 2: ACCIONES INFERIORES (EXTREMO IZQUIERDO Y DERECHO) -->
                <Grid Grid.Row="2">
                    <!-- Acción izquierda: Limpiar -->
                    <Button HorizontalAlignment="Left" Content="🔄 Limpiar" Command="{Binding LimpiarFiltrosCommand}" 
                            Padding="12,7" Background="#95A5A6" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" ToolTip="Restablecer filtros">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Acciones derecha: Imprimir Listado y Nueva Orden -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="📄 Imprimir Listado" Command="{Binding ImprimirListadoFiltradoCommand}" 
                                Padding="12,7" Margin="0,0,10,0" Background="#8E44AD" Foreground="White" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Exportar órdenes filtradas a PDF">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="btnNuevaOrden" Content="➕ Nueva Orden" Click="BtnNuevaOrden_Click" 
                                Padding="14,7" Background="#27AE60" Foreground="White" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand" Visibility="{Binding PuedeCrear, Converter={StaticResource BoolToVis}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- FILA 3: MENSAJE DE VALIDACION DE FECHAS -->
                <TextBlock Grid.Row="3" Text="{Binding MensajeValidacionFechas}" Foreground="#E74C3C" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- TABLA DE ORDENES -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10" Margin="0,50,0,0">
                    <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Foreground="#BDC3C7"/>
                    <TextBlock Text="No se encontraron órdenes de servicio" FontSize="16" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Crea una nueva o intentá con otra búsqueda." FontSize="13" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            <DataGrid x:Name="dgOrdenes"
                      ItemsSource="{Binding ListadoOrdenesFiltered}"
                      SelectedItem="{Binding OrdenSeleccionada}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single" 
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeaderWidth="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteDetalle}" Width="*"/>
                    <DataGridTextColumn Header="Patente" Binding="{Binding VehiculoPatente}" Width="100"/>
                    <DataGridTextColumn Header="Vehículo" Binding="{Binding VehiculoDetalle}" Width="100"/>
                    <DataGridTextColumn Header="Recepción" Binding="{Binding RecepcionistaNombre}" Width="100"/>
                    <DataGridTextColumn Header="Km" Binding="{Binding KmIngreso}" Width="80"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>

        <!-- PIE DE ACCIONES -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#x1F4C4; Comp. Recepción" Click="BtnComprobanteOrden_Click" Padding="12,8" Background="#8E44AD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Visibility="{Binding PuedeImprimirRecepcion, Converter={StaticResource BoolToVis}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="&#x1F4C4; Comp. Pago" Click="BtnComprobantePago_Click" Padding="12,8" Background="#8E44AD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Visibility="{Binding PuedeVerComprobantePago, Converter={StaticResource BoolToVis}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="💳 Pagar" Click="BtnPagar_Click" Padding="12,8" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Visibility="{Binding PuedePagar, Converter={StaticResource BoolToVis}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="✏️ Editar Seleccionada" Click="BtnEditar_Click" Padding="12,8" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btnEliminar" Content="🗑️ Eliminar / Cancelar" Click="BtnEliminar_Click" Padding="12,8" Background="#C0392B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Visibility="{Binding PuedeEliminar, Converter={StaticResource BoolToVis}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


