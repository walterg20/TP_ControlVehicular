<Window x:Class="TP_ControlVehicular.Presentacion.Pantalla.OrdenServicio.FrmPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procesar Pago" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F6FA" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Total a Pagar:" FontSize="16" FontWeight="Bold" Foreground="#333"/>
            <TextBlock x:Name="lblTotal" Text="$ 0.00" FontSize="24" FontWeight="Bold" Foreground="#4CAF50"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Gray" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Método de Pago" FontWeight="Bold" Margin="0,0,0,10"/>
                <RadioButton x:Name="optEfectivo" Content="Efectivo" IsChecked="True" Checked="optEfectivo_Checked" Margin="0,0,0,5"/>
                <RadioButton x:Name="optTarjeta" Content="Tarjeta" Checked="optTarjeta_Checked"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Gray" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <StackPanel x:Name="pnlEfectivo" Visibility="Visible">
                    <TextBlock Text="Monto Recibido:" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMontoRecibido" Padding="5" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel x:Name="pnlTarjeta" Visibility="Collapsed">
                    <TextBlock Text="Número de Tarjeta:" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNumeroTarjeta" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Titular ('apro', 'lim', 'rec'):" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTitular" Padding="5" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Vencimiento:" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtVencimiento" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="CVV:" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtCvv" Padding="5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="lblCargando" Text="Procesando..." Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" Foreground="#FF9800"/>
            <Button x:Name="cmdPagar" Content="Pagar" Width="100" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" Click="cmdPagar_Click"/>
            <Button x:Name="cmdCancelar" Content="Cancelar" Width="100" Height="35" Background="#F44336" Foreground="White" Click="cmdCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
