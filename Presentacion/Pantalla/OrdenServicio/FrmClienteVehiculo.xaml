<Window x:Class="TP_ControlVehicular.Presentacion.Pantalla.OrdenServicio.FrmClienteVehiculo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Registrar Cliente y Vehículo" Height="520" Width="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=txtPatente}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="lblTituloFormulario" Text="Registrar Nuevo Cliente y Vehículo" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Se crearán el cliente, el vehículo y su vínculo en un solo paso." FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Formulario en dos columnas -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUMNA IZQUIERDA: DATOS DEL CLIENTE -->
                <Border Grid.Column="0" Background="#F8F9F9" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Datos del Cliente" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DNI / CUIT:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBox x:Name="txtDni" Height="30"
                                     IsEnabled="{Binding PuedeEditarCliente}"
                                     Text="{Binding Dni, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtDni, FallbackValue=''}"
                                       Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding (Validation.HasError), ElementName=txtDni, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Apellido y Nombre:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBox x:Name="txtApellido" Height="30" Margin="0,0,0,8"
                                     IsEnabled="{Binding PuedeEditarCliente}"
                                     Text="{Binding Apellido, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtApellido, FallbackValue=''}"
                                       Foreground="#E74C3C" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Visibility="{Binding (Validation.HasError), ElementName=txtApellido, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <TextBox x:Name="txtNombre" Height="30" Margin="0,0,0,8"
                                     IsEnabled="{Binding PuedeEditarCliente}"
                                     Text="{Binding Nombre, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtNombre, FallbackValue=''}"
                                       Foreground="#E74C3C" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Visibility="{Binding (Validation.HasError), ElementName=txtNombre, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <TextBox x:Name="txtTelefono" Height="30"
                                     IsEnabled="{Binding PuedeEditarCliente}"
                                     Text="{Binding Telefono, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtTelefono, FallbackValue=''}"
                                       Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding (Validation.HasError), ElementName=txtTelefono, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- COLUMNA DERECHA: DATOS DEL VEHÍCULO -->
                <Border Grid.Column="2" Background="#F8F9F9" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Datos del Vehículo" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Patente / Dominio:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBox x:Name="txtPatente" Height="30"
                                     Text="{Binding Patente, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtPatente, FallbackValue=''}"
                                       Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding (Validation.HasError), ElementName=txtPatente, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Marca y Modelo:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                            <ComboBox x:Name="cmbMarca" Height="30" Margin="0,0,0,8"
                                      ItemsSource="{Binding MarcasDisponibles}" DisplayMemberPath="NombreMarca" SelectedValuePath="Id"
                                      SelectedValue="{Binding IdMarca, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=cmbMarca, FallbackValue=''}"
                                       Foreground="#E74C3C" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Visibility="{Binding (Validation.HasError), ElementName=cmbMarca, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <ComboBox x:Name="cmbModelo" Height="30"
                                      ItemsSource="{Binding ModelosDisponibles}" DisplayMemberPath="NombreModelo" SelectedValuePath="Id"
                                      SelectedValue="{Binding IdModelo, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=cmbModelo, FallbackValue=''}"
                                       Foreground="#E74C3C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding (Validation.HasError), ElementName=cmbModelo, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Año / Motor (opcionales):" FontWeight="Bold" Margin="0,0,0,2"/>
                        <Grid Grid.Row="6" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtAnio" Grid.Column="0" Height="30"
                                     Text="{Binding Anio, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBox x:Name="txtMotor" Grid.Column="2" Height="30"
                                     ToolTip="Cilindrada del motor. Dato opcional informative: no se persiste."
                                     Text="{Binding Motor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,20,0,0">
            <Button Content="🔗 Guardar y Vincular" Width="170" Height="34" IsDefault="True" Click="BtnGuardar_Click"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="❌ Cancelar" Width="105" Height="34" Click="BtnCancelar_Click"
                    Background="#C0392B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
