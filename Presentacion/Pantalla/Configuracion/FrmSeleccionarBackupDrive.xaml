<Window x:Class="TP_ControlVehicular.Presentacion.Pantalla.Configuracion.FrmSeleccionarBackupDrive"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar respaldo de Google Drive"
        Height="420" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Seleccione un respaldo de Google Drive para descargar y restaurar:" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#2C3E50"/>

        <DataGrid Grid.Row="1" x:Name="dgArchivos" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" Background="Transparent"
                  BorderThickness="1" BorderBrush="#BDC3C7" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Archivo" Binding="{Binding Nombre}" Width="2*"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaModificacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="1.3*"/>
                <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoLegible}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✓ Aceptar" IsDefault="True" Click="BtnAceptar_Click"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="❌ Cancelar" IsCancel="True" Click="BtnCancelar_Click"
                    Background="#C0392B" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>