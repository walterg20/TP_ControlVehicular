<Window x:Class="TP_ControlVehicular.Presentacion.Pantalla.Configuracion.FrmAutorizacionBackup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorización de Restauración"
        Height="320" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔐 Segundo Factor de Autorización" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Ingrese las credenciales de otro usuario con permiso de gestión de respaldos para autorizar la restauración." FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- FORMULARIO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="DNI:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="txtDni" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,8"
                     TextChanged="TxtDni_TextChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Contraseña:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <PasswordBox x:Name="pwdContrasena" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,8"
                         PasswordChanged="PwdContrasena_PasswordChanged"/>
        </Grid>

        <!-- BOTONES -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="✓ Aceptar" IsDefault="True" Click="BtnAceptar_Click"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="❌ Cancelar" IsCancel="True" Click="BtnCancelar_Click"
                    Background="#C0392B" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>